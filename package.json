{
  "name": "imo-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "worker": "tsx apps/worker/src/cli.ts",
    "web": "tsx apps/web/src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "bash scripts/demo.sh"
  },
  "devDependencies": {
    "@imo/connectors": "workspace:*",
    "@imo/contracts": "workspace:*",
    "@imo/db": "workspace:*",
    "@imo/domain": "workspace:*",
    "@imo/web": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
